# Copia este archivo como ".env" y completa tu clave. NUNCA subas el ".env" al repositorio.
# En Google Colab no necesitas .env: guarda estos nombres en el panel 🔑 Secrets.

# Proveedor LLM compatible con OpenAI (Mistral por defecto)
LLM_BASE_URL="https://api.mistral.ai/v1"
LLM_API_KEY=""
LLM_MODEL="mistral-small-latest"
